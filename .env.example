# --- Número EXCLUSIVO de cobranza (Meta WhatsApp Cloud API) ---
COLLECTIONS_WHATSAPP_TOKEN=
COLLECTIONS_WHATSAPP_PHONE_NUMBER_ID=
# String que tú inventas y pones también en el panel de Meta al configurar este webhook
COLLECTIONS_WHATSAPP_VERIFY_TOKEN=
# Nombre de la plantilla aprobada para iniciar conversaciones de cobranza
COLLECTIONS_WHATSAPP_TEMPLATE_NAME=

# --- Número del community manager (Meta WhatsApp Cloud API, 1:1) ---
COMMUNITY_WHATSAPP_TOKEN=
COMMUNITY_WHATSAPP_PHONE_NUMBER_ID=
COMMUNITY_WHATSAPP_VERIFY_TOKEN=

# Claude
ANTHROPIC_API_KEY=

# App
PORT=3000
# Horario del cron de recordatorios de cobranza (formato cron, hora del servidor)
COLLECTIONS_CRON=0 9 * * *
