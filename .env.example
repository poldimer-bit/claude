# Meta WhatsApp Cloud API (https://developers.facebook.com/apps)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# String que tú inventas y pones también en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# Nombre de la plantilla aprobada para iniciar conversaciones de cobranza fuera de la ventana de 24h
WHATSAPP_COLLECTIONS_TEMPLATE_NAME=

# Claude
ANTHROPIC_API_KEY=

# App
PORT=3000
# Horario del cron de recordatorios de cobranza (formato cron, hora del servidor)
COLLECTIONS_CRON=0 9 * * *
